# Which desktop apps appear on the landing page (dock, menu bar, home grid, deep links, terminal).
# true / false. Leave a line out (or empty) to use the default shown here.
#
# Local:      copy to .env.local (git-ignored) and edit.
# Production: set them as GitHub repository Variables
#             (Settings → Secrets and variables → Actions → Variables); deploy.yml passes them to the build.

VITE_SHOW_ABOUT=true
VITE_SHOW_PROJECTS=true
VITE_SHOW_EXPERIENCE=true
VITE_SHOW_STACK=true
VITE_SHOW_NOTES=true
VITE_SHOW_TERMINAL=true
VITE_SHOW_CONTACT=true

# Off by default: the Spotify Web API answers 403 unless the app owner has Premium.
VITE_SHOW_SPOTIFY=false
